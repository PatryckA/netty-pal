rules_version = '2';

// Netty Pal security rules.
// Paste this whole file into Firebase console > Firestore Database > Rules, then Publish.
//
// Summary:
//   - Everyone must be signed in with Google.
//   - A season's data can only be read by its members (and the team admin).
//   - Joining needs the season's current code.
//   - Only the team admin can change roles, remove people, change codes or settings.
//   - Admin or Coach can edit the player roster.
//   - A code can only ever be created once, never overwritten.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }

    function teamPath(teamId) { return /databases/$(database)/documents/teams/$(teamId); }
    function seasonPath(teamId, seasonId) { return /databases/$(database)/documents/teams/$(teamId)/seasons/$(seasonId); }
    function memberPath(teamId, seasonId, uid) { return /databases/$(database)/documents/teams/$(teamId)/seasons/$(seasonId)/members/$(uid); }

    // "Before" checks: the database as it is now.
    function isAdmin(teamId) {
      return signedIn() && exists(teamPath(teamId)) && get(teamPath(teamId)).data.adminUid == me();
    }
    function isMember(teamId, seasonId) {
      return signedIn() && exists(memberPath(teamId, seasonId, me()));
    }
    function hasRole(teamId, seasonId, role) {
      return isMember(teamId, seasonId) && role in get(memberPath(teamId, seasonId, me())).data.roles;
    }

    // "After" check: the database as it will be once this write (or batch
    // of writes) completes. Needed when a team and its first season are
    // created together in one go.
    function isAdminAfter(teamId) {
      return signedIn() && getAfter(teamPath(teamId)).data.adminUid == me();
    }

    // Each user's own list of seasons they belong to.
    match /users/{uid}/memberships/{seasonId} {
      allow read, write: if signedIn() && me() == uid;
    }

    // Season codes. Anyone signed in can look up a single code (that's how
    // joining works) but nobody can list them all.
    match /joinCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if isAdminAfter(request.resource.data.teamId)
        && getAfter(seasonPath(request.resource.data.teamId, request.resource.data.seasonId)).data.joinCode == code;
      allow update: if false;
      allow delete: if isAdmin(resource.data.teamId);
    }

    match /teams/{teamId} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && request.resource.data.adminUid == me();
      allow update: if isAdmin(teamId);
      allow delete: if false;

      match /seasons/{seasonId} {
        allow read: if isMember(teamId, seasonId) || isAdmin(teamId);
        allow create: if isAdminAfter(teamId);
        allow update: if isAdmin(teamId);
        allow delete: if false;

        match /members/{uid} {
          allow read: if isMember(teamId, seasonId) || isAdmin(teamId) || (signedIn() && me() == uid);
          // Admin adds people (including themselves when creating a season),
          // or a user adds themselves as a Viewer with the current code.
          allow create: if isAdminAfter(teamId)
            || (signedIn() && me() == uid
                && request.resource.data.roles.size() == 0
                && request.resource.data.code == get(seasonPath(teamId, seasonId)).data.joinCode);
          allow update: if isAdmin(teamId);
          // Admin removes people; anyone can leave.
          allow delete: if isAdmin(teamId) || (signedIn() && me() == uid);
        }

        match /players/{playerId} {
          allow read: if isMember(teamId, seasonId) || isAdmin(teamId);
          allow write: if isAdmin(teamId) || hasRole(teamId, seasonId, 'coach');
        }

        // Fixtures, availability and lineup plans: admin or Coach.
        // (Live scoring in step 2b will add what Scorers can write.)
        match /games/{gameId} {
          allow read: if isMember(teamId, seasonId) || isAdmin(teamId);
          allow write: if isAdmin(teamId) || hasRole(teamId, seasonId, 'coach');
        }
      }
    }
  }
}
