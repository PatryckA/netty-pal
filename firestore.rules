rules_version = '2';

// Netty Pal security rules.
// Paste this whole file into Firebase console > Firestore Database > Rules, then Publish.
//
// Summary:
//   - Everyone must be signed in.
//   - A season's data can only be read by its members.
//   - Joining needs the season's current code, or a one-time role invite
//     link from a Coach/Manager (which makes them a Coach/Manager or Scorer).
//   - Coach/Managers run the team: settings, roles, removing people, codes,
//     players, games. (There is no separate "admin" any more.)
//   - Scorers can run a game on the day. Coach/Managers and Scorers can both
//     make substitutions, but only whoever is scoring can start or stop the clock.
//   - The app owner (one Google account, below) can read and manage every
//     team without being a member, and is the only one who can delete a
//     whole team (its seasons, games and game events).
//   - A code can only ever be created once, never overwritten.
//   - Player awards can only be seen or given by Coach/Managers.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }

    // The app owner. Must match OWNER_EMAIL in index.html.
    function isOwner() {
      return signedIn()
        && request.auth.token.get('email', '') == 'patryck.allen@gmail.com'
        && request.auth.token.get('email_verified', false) == true;
    }

    function teamPath(teamId) { return /databases/$(database)/documents/teams/$(teamId); }
    function seasonPath(teamId, seasonId) { return /databases/$(database)/documents/teams/$(teamId)/seasons/$(seasonId); }
    function memberPath(teamId, seasonId, uid) { return /databases/$(database)/documents/teams/$(teamId)/seasons/$(seasonId)/members/$(uid); }

    // "Before" checks: the database as it is now.
    function isMember(teamId, seasonId) {
      return signedIn() && exists(memberPath(teamId, seasonId, me()));
    }
    function hasRole(teamId, seasonId, role) {
      return isMember(teamId, seasonId) && role in get(memberPath(teamId, seasonId, me())).data.roles;
    }
    function isManager(teamId, seasonId) {
      return isOwner() || hasRole(teamId, seasonId, 'coach');
    }
    function canRead(teamId, seasonId) {
      return isOwner() || isMember(teamId, seasonId);
    }

    // "After" checks: the database as it will be once this batch of writes
    // completes. Used when a team or a season is being created in one go
    // (the season, the creator's member record, its code and players).
    // A new team: it doesn't exist yet, and the creator is named on it.
    function creatingTeam(teamId) {
      return signedIn() && !exists(teamPath(teamId))
        && getAfter(teamPath(teamId)).data.adminUid == me();
    }
    // A new season: it doesn't exist yet, and it's part of a new team, or the
    // person is Coach/Manager of the season it was started from.
    function creatingSeason(teamId, seasonId) {
      return signedIn() && !exists(seasonPath(teamId, seasonId)) && (
        isOwner()
        || creatingTeam(teamId)
        || ('fromSeason' in getAfter(seasonPath(teamId, seasonId)).data
            && hasRole(teamId, getAfter(seasonPath(teamId, seasonId)).data.fromSeason, 'coach')));
    }

    // Role invite links: a one-time link that makes someone a Coach/Manager
    // or Scorer as they join. roleInvites/{code} says which team, season and
    // role; the code is long and random, so it can't be guessed.
    function rolePath(code) { return /databases/$(database)/documents/roleInvites/$(code); }
    // The member record being written uses this invite: it must exist, be
    // for this team and season, and be used up (deleted) in the same save.
    function usingInvite(teamId, seasonId, code) {
      return code is string && code.size() >= 12
        && exists(rolePath(code))
        && get(rolePath(code)).data.teamId == teamId
        && get(rolePath(code)).data.seasonId == seasonId
        && !existsAfter(rolePath(code));
    }
    // The person deleting an invite has just used it (their member record,
    // after this save, names it).
    function justUsed(teamId, seasonId, code) {
      return signedIn() && getAfter(memberPath(teamId, seasonId, me())).data.get('invite', '') == code;
    }

    match /roleInvites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if isManager(request.resource.data.teamId, request.resource.data.seasonId)
        && request.resource.data.role in ['coach', 'scorer']
        && code.size() >= 12;
      allow update: if false;
      allow delete: if isManager(resource.data.teamId, resource.data.seasonId)
        || justUsed(resource.data.teamId, resource.data.seasonId, code);
    }

    // Each user's own list of seasons they belong to.
    match /users/{uid}/memberships/{seasonId} {
      allow read, write: if signedIn() && me() == uid;
    }

    // Season codes. Anyone signed in can look up a single code (that's how
    // joining works) but nobody can list them all.
    match /joinCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if (creatingSeason(request.resource.data.teamId, request.resource.data.seasonId)
          || isManager(request.resource.data.teamId, request.resource.data.seasonId))
        && getAfter(seasonPath(request.resource.data.teamId, request.resource.data.seasonId)).data.joinCode == code;
      allow update: if false;
      allow delete: if isManager(resource.data.teamId, resource.data.seasonId);
    }

    match /teams/{teamId} {
      allow get: if signedIn();
      // Only the owner can list every team (the owner's "show every team").
      allow list: if isOwner();
      allow create: if signedIn() && request.resource.data.adminUid == me();
      // Renaming the team: a Coach/Manager of the season named in editSeason.
      allow update: if isOwner()
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'editSeason'])
            && hasRole(teamId, request.resource.data.editSeason, 'coach'));
      // Only the owner deletes a team (and, below, its seasons and events).
      allow delete: if isOwner();

      match /seasons/{seasonId} {
        allow read: if canRead(teamId, seasonId);
        allow create: if creatingSeason(teamId, seasonId);
        allow update: if isManager(teamId, seasonId);
        allow delete: if isOwner();

        match /members/{uid} {
          allow read: if canRead(teamId, seasonId) || (signedIn() && me() == uid);
          // A Coach/Manager adds people (including themselves when creating
          // a season), or a user adds themselves: as a Viewer with the current
          // code, or with exactly the role a one-time invite link gives.
          allow create: if creatingSeason(teamId, seasonId) || isManager(teamId, seasonId)
            || (signedIn() && me() == uid
                && request.resource.data.roles.size() == 0
                && request.resource.data.code == get(seasonPath(teamId, seasonId)).data.joinCode)
            || (signedIn() && me() == uid
                && usingInvite(teamId, seasonId, request.resource.data.get('invite', ''))
                && request.resource.data.roles == [get(rolePath(request.resource.data.invite)).data.role]);
          // A Coach/Manager changes roles, or someone already in the season
          // adds the one role their invite link gives (and nothing else).
          allow update: if isManager(teamId, seasonId)
            || (signedIn() && me() == uid
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['roles', 'invite'])
                && usingInvite(teamId, seasonId, request.resource.data.get('invite', ''))
                && request.resource.data.roles.hasAll(resource.data.roles)
                && request.resource.data.roles.removeAll(resource.data.roles)
                     .hasOnly([get(rolePath(request.resource.data.invite)).data.role]));
          // A Coach/Manager removes people; anyone can leave.
          allow delete: if isManager(teamId, seasonId) || (signedIn() && me() == uid);
        }

        // The list of unused role invite links, so Coach/Managers can see and
        // cancel them. Each one matches a roleInvites/{code} doc.
        match /invites/{code} {
          allow read: if isManager(teamId, seasonId);
          allow create: if isManager(teamId, seasonId) && existsAfter(rolePath(code));
          allow update: if false;
          allow delete: if isManager(teamId, seasonId) || justUsed(teamId, seasonId, code);
        }

        // Player awards: only Coach/Managers can see or give them (parents
        // and Scorers can't). awards/settings holds the award names; one
        // doc per game (awards/{gameId}) holds that game's winners.
        match /awards/{docId} {
          allow read, write: if isManager(teamId, seasonId);
        }

        match /players/{playerId} {
          allow read: if canRead(teamId, seasonId);
          allow write: if creatingSeason(teamId, seasonId) || isManager(teamId, seasonId);
        }

        // Fixtures, availability and lineups: Coach/Managers.
        // Scorers can run the game (clock, status, who's scoring, who's playing,
        // the lineup plan and the saved summary) but not change the fixture,
        // and not once it's finalised. Coach/Managers can unlock a finalised game.
        match /games/{gameId} {
          function canRunGame() {
            return isManager(teamId, seasonId) || hasRole(teamId, seasonId, 'scorer');
          }
          function notFinal() { return resource.data.get('status', 'scheduled') != 'final'; }

          // The game clock (live: period, running or paused) can only be
          // changed by whoever is scoring, or by the person starting the game
          // (who becomes the scorer). Anyone else must take over scoring first.
          function clockOk() {
            return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['live'])
              || isOwner()
              || resource.data.get('scorerUid', '') == me()
              || (resource.data.get('status', 'scheduled') == 'scheduled' && request.resource.data.get('scorerUid', '') == me());
          }

          allow read: if canRead(teamId, seasonId);
          allow create, delete: if isManager(teamId, seasonId);
          allow update: if clockOk() && (isManager(teamId, seasonId)
            || (notFinal() && hasRole(teamId, seasonId, 'scorer')
                && request.resource.data.diff(resource.data).affectedKeys()
                     .hasOnly(['live', 'status', 'scorerUid', 'scorerName', 'available', 'plan', 'summary'])));

          // Everything that happens in a game. Events are never deleted:
          // undo and corrections mark them undone or change the player.
          // (Except by the owner, when deleting a whole team.)
          match /events/{eventId} {
            function gameNotFinal() {
              return get(/databases/$(database)/documents/teams/$(teamId)/seasons/$(seasonId)/games/$(gameId)).data.get('status', 'scheduled') != 'final';
            }
            allow read: if canRead(teamId, seasonId);
            allow create: if canRunGame() && gameNotFinal() && request.resource.data.by == me();
            allow update: if canRunGame() && gameNotFinal()
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['undone', 'playerId']);
            allow delete: if isOwner();
          }
        }
      }
    }
  }
}
